<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Erbaa Kurs — sertleştirilmiş çalışma zamanı (hardened runtime) yetkileri.
  * Uygulama kum havuzunda (App Sandbox) DEĞİL: Developer ID ile site üzerinden dağıtılır; gömülü PHP
    alt süreçleri ve uygulama veri klasörü için kum havuzu gerekmez.
  * JIT KAPALI: com.apple.security.cs.allow-jit / allow-unsigned-executable-memory verilmez;
    PHP tarafında pcre.jit=0 ve opcache.jit=disable (runtime/php.ini).
  * Ağ istemci/sunucu yetkileri yalnız kum havuzunda anlamlıdır; ileride kum havuzuna geçilirse hazır dursun diye yazıldı.
  * Anahtar Zinciri: Developer ID uygulamaları kendi oluşturduğu genel parola kayıtlarına ek yetki olmadan erişir
    (erişim listesi uygulamanın imzasına bağlıdır; aynı Team ID ile imzalanan güncellemeler aynı kayda erişir).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
</dict>
</plist>
