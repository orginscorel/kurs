# Erbaa Bilgi Eğitim masaüstü — yerel kurulum yapılandırması.
# Uygulama ilk kurulumda bu dosyayı üretir ({{…}} alanlarını doldurur) ve her açılışta okuyup PHP sürecine
# ortam değişkeni olarak verir. SIRLAR BURADA YOK: APP_KEY, SYNC_DEVICE_TOKEN ve KURS_DATA_KEY macOS Anahtar
# Zinciri'nde tutulur ve yalnız süreç başlatılırken ortam değişkeni olarak eklenir.
# Elle düzenlemek gerekirse uygulamayı kapatın; bozuk satırlar yok sayılır.

APP_NAME="Erbaa Bilgi Eğitim"
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

KURS_NODE=local
KURS_DESKTOP=1

DB_CONNECTION=sqlite
DB_DATABASE={{DB_PATH}}
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

SYNC_SERVER_URL={{SERVER_URL}}
SYNC_INTERVAL=30
